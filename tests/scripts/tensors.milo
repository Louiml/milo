let a = tensor([1, 2, 3])
let b = tensor([4, 5, 6])

print "a:"
print a
print "a + b:"
print add(a, b)
print "a * b:"
print mul(a, b)

let m = matmul(reshape(a, [1, 3]), reshape(b, [3, 1]))
print "matmul:"
print m

print "sum:"
print sum(m)
print "shape:"
print shape(m)
print "dtype:"
print dtype(m)
