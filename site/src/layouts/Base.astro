---
import { getCollection } from 'astro:content';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'Milo', description = 'A programming language for AI and data work.' } = Astro.props;

const reference = await getCollection('reference');
const spec = reference.find((entry) => entry.id.endsWith('language-spec-v0-1'));
const roadmap = reference.find((entry) => entry.id === 'roadmap');

// The site is published under a path, so every link carries it.
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Milo</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={`${title} — Milo`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <div class="shell">
      <header class="topbar">
        <a class="brand" href={base}>
          <span class="mark">M</span>ilo<span class="version">0.1</span>
        </a>
        <nav class="topnav">
          <a href={`${base}guides/getting-started/`}>Guides</a>
          {spec && <a href={`${base}docs/${spec.id}/`}>Specification</a>}
          {roadmap && <a href={`${base}docs/${roadmap.id}/`}>Roadmap</a>}
        </nav>
      </header>

      <slot />

      <footer class="footer">
        Milo — a programming language for AI and data work. MIT licensed.
      </footer>
    </div>
  </body>
</html>
